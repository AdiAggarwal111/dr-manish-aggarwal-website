# =============================================================================
# Dr. Manish Aggarwal Cardiology — Environment Variables
# =============================================================================

# 1. Resend API Key for automated instant email dispatch
# Get your API key at: https://resend.com/api-keys
# When present, appointment requests are instantly emailed to appointments@drmanishaggarwal.com
# and an automated confirmation is dispatched to the patient.
# In local development without this key, submissions are logged directly to the console.
RESEND_API_KEY=re_your_api_key_here

# 2. Verified Sender Email
# For production: use your verified domain address (e.g. appointments@drmanishaggarwal.com)
# For initial testing before domain DNS verification: use "Dr. Manish Aggarwal <onboarding@resend.dev>"
APPOINTMENT_FROM_EMAIL="Dr. Manish Aggarwal <appointments@drmanishaggarwal.com>"

# 3. Optional Hospital CRM / Slack / WhatsApp Webhook URL
# When specified, every appointment submission also sends a JSON payload to this endpoint.
# APPOINTMENT_WEBHOOK_URL=https://api.yourhospitalcrm.com/webhooks/appointments
